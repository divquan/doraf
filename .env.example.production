# Copy this file to env.production and fill in the deployment-specific values.
# env.production is loaded by every script in deploy/gcloud/ and is ignored by
# git. Do not put application secrets here; runtime secrets are mounted from
# Google Secret Manager by the deployment scripts.

PROJECT_ID=replace-with-google-cloud-project-id
REGION=us-central1
REPOSITORY=dashchecker
# Cloud Build location. `global` is the default; use a supported regional
# location if the project requires regional builds.
BUILD_REGION=global
QUEUE=dashchecker-outbox

# The scripts validate this pair. Use NODE_ENV=development and
# PAYSTACK_MODE=sandbox only for an explicitly isolated staging deployment.
NODE_ENV=production
PAYSTACK_MODE=live
PAYSTACK_GUEST_EMAIL_DOMAIN=replace-with-controlled-production-domain

# WebAuthn relying-party settings for the administration web app.
INTERNAL_AUTH_RP_NAME="Dashchecker Administration"
INTERNAL_AUTH_RP_ID=admin.example.com
INTERNAL_AUTH_ORIGIN=https://admin.example.com

# Set this after building/publishing an immutable image. The value must end in
# @sha256:<64 hex characters>. build-image.sh prints the value to use here.
# IMAGE_URI=us-central1-docker.pkg.dev/replace-with-project/dashchecker/dashchecker-api:BUILD_ID@sha256:...

# Optional: set this after the task consumer exists. If omitted, deploy-api,
# and deploy jobs derive it from the deployed Cloud Run service.
# TASK_CONSUMER_URL=https://dashchecker-task-consumer-XXXX-uc.a.run.app

# Set to true only when create-crypto-secret.sh should grant the generated
# secret to the three runtime service accounts after IAM setup.
GRANT_ACCESS=false
