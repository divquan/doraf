NODE_ENV=development
# The HTTP API and task consumer keep this false. Cloud Run Jobs set this true.
WORKER_ENABLED=false
# Jobs are bounded one-shot processes.
WORKER_EXECUTION=run-once
CLOUD_TASKS_PROJECT_ID=test-project
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=outbox
CLOUD_TASKS_TARGET_URL=http://localhost:3000/internal/tasks/outbox
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=test@test-project.iam.gserviceaccount.com
CLOUD_TASKS_AUDIENCE=http://localhost:3000/internal/tasks/outbox
PORT=3000

# Local development defaults for `docker compose up -d`.
# In Cloud Run, use the Supabase transaction pooler URL for DATABASE_URL and
# the Supabase direct connection URL for DIRECT_URL.
DATABASE_URL=postgresql://dashchecker:dashchecker@localhost:5432/dashchecker
DIRECT_URL=postgresql://dashchecker:dashchecker@localhost:5432/dashchecker

# Consolidate nine distinct cryptographic keys into one Secret Manager JSON value.
# Generate each value independently with `openssl rand -base64 32` — do not reuse a value across purposes.
# Keep two separately controlled recovery copies before importing vouchers.
# Store outside source control; in Cloud Run, inject via Secret Manager as DASHCHECKER_CRYPTO_KEYS_JSON.
# For local development, create a one-line JSON string as below (values must be distinct).
# Example generator (run nine times, collect outputs):
#   for k in VOUCHER_MASTER_KEY_BASE64 VOUCHER_FINGERPRINT_KEY_BASE64 SESSION_FINGERPRINT_KEY_BASE64 INTERNAL_ENROLLMENT_FINGERPRINT_KEY_BASE64 AGENT_PHONE_ENCRYPTION_KEY_BASE64 AGENT_PHONE_FINGERPRINT_KEY_BASE64 OTP_FINGERPRINT_KEY_BASE64 ORDER_CONTACT_ENCRYPTION_KEY_BASE64 ORDER_CONTACT_FINGERPRINT_KEY_BASE64; do echo "$k=$(openssl rand -base64 32)"; done
DASHCHECKER_CRYPTO_KEYS_JSON={"VOUCHER_MASTER_KEY_BASE64":"replace-with-exactly-32-random-bytes-in-base64-1","VOUCHER_FINGERPRINT_KEY_BASE64":"replace-with-at-least-32-random-bytes-in-base64-2","SESSION_FINGERPRINT_KEY_BASE64":"replace-with-another-32-random-bytes-in-base64-3","INTERNAL_ENROLLMENT_FINGERPRINT_KEY_BASE64":"replace-with-a-third-32-random-bytes-in-base64-4","AGENT_PHONE_ENCRYPTION_KEY_BASE64":"replace-with-a-fourth-32-random-bytes-in-base64-5","AGENT_PHONE_FINGERPRINT_KEY_BASE64":"replace-with-a-fifth-32-random-bytes-in-base64-6","OTP_FINGERPRINT_KEY_BASE64":"replace-with-a-sixth-32-random-bytes-in-base64-7","ORDER_CONTACT_ENCRYPTION_KEY_BASE64":"replace-with-a-seventh-32-random-bytes-in-base64-8","ORDER_CONTACT_FINGERPRINT_KEY_BASE64":"replace-with-an-eighth-32-random-bytes-in-base64-9"}

# `example.com` is a Paystack-valid sandbox default. Production must use a
# controlled hostname and configure how inbound mail is handled before enabling Paystack.
PAYSTACK_GUEST_EMAIL_DOMAIN=example.com
# Sandbox is required outside production and sends only Paystack test transactions.
PAYSTACK_MODE=sandbox
PAYSTACK_SECRET_KEY=sk_test_replace-me

# Hubtel SMS (Ghana) — required in production for OTP and voucher SMS.
# Obtain Client ID / Client Secret and Sender ID from Hubtel dashboard (https://hubtel.com).
# In development the local adapter logs SMS; in production Hubtel is used when these are set.
# HUBTEL_CLIENT_ID=your-hubtel-client-id
# HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
# HUBTEL_SENDER_ID=Dashchecker
# HUBTEL_BASE_URL=https://smsc.hubtel.com/v1/messages/send

# Loops email — required in production for voucher email delivery.
# Create a transactional email in Loops (https://app.loops.so), publish it, and copy its transactional ID.
# The template should use data variables: orderReference, productCode, productName, quantity, vouchers (array with position, serialNumber, pin), deliveryReference.
# LOOPS_API_KEY=your-loops-api-key
# LOOPS_VOUCHER_TRANSACTIONAL_ID=your-loops-transactional-id

# Agent SMS OTP authentication. Development responses include the OTP so local
# testing does not require an SMS account; production requires a provider adapter.
AGENT_AUTH_OTP_TTL_SECONDS=300
AGENT_AUTH_OTP_MAX_ATTEMPTS=5
AGENT_AUTH_REGISTRATION_TTL_SECONDS=900
AGENT_AUTH_SESSION_TTL_SECONDS=2592000

# WebAuthn relying-party settings. Origin is the administration web app origin.
INTERNAL_AUTH_RP_NAME=Dashchecker Administration
INTERNAL_AUTH_RP_ID=localhost
INTERNAL_AUTH_ORIGIN=http://localhost:3001
INTERNAL_AUTH_CHALLENGE_TTL_SECONDS=300
INTERNAL_AUTH_SESSION_TTL_SECONDS=28800
INTERNAL_ENROLLMENT_TTL_SECONDS=900
