NODE_ENV=development
PORT=3000

# Local development defaults for `docker compose up -d`.
# In Cloud Run, use the Supabase transaction pooler URL for DATABASE_URL and
# the Supabase direct connection URL for DIRECT_URL.
DATABASE_URL=postgresql://doraf:doraf@localhost:5432/doraf
DIRECT_URL=postgresql://doraf:doraf@localhost:5432/doraf

# Generate with `openssl rand -base64 32`; store outside source control and
# keep two separately controlled recovery copies before importing vouchers.
VOUCHER_MASTER_KEY_BASE64=replace-with-exactly-32-random-bytes-in-base64
VOUCHER_FINGERPRINT_KEY_BASE64=replace-with-at-least-32-random-bytes-in-base64
SESSION_FINGERPRINT_KEY_BASE64=replace-with-another-32-random-bytes-in-base64
INTERNAL_ENROLLMENT_FINGERPRINT_KEY_BASE64=replace-with-a-third-32-random-bytes-in-base64
AGENT_PHONE_ENCRYPTION_KEY_BASE64=replace-with-a-fourth-32-random-bytes-in-base64
AGENT_PHONE_FINGERPRINT_KEY_BASE64=replace-with-a-fifth-32-random-bytes-in-base64
OTP_FINGERPRINT_KEY_BASE64=replace-with-a-sixth-32-random-bytes-in-base64
ORDER_CONTACT_ENCRYPTION_KEY_BASE64=replace-with-a-seventh-32-random-bytes-in-base64
ORDER_CONTACT_FINGERPRINT_KEY_BASE64=replace-with-an-eighth-32-random-bytes-in-base64

# `example.com` is a Paystack-valid sandbox default. Production must use a
# controlled hostname and configure how inbound mail is handled before enabling Paystack.
PAYSTACK_GUEST_EMAIL_DOMAIN=example.com
# Sandbox is required outside production and sends only Paystack test transactions.
PAYSTACK_MODE=sandbox
PAYSTACK_SECRET_KEY=sk_test_replace-me

# Agent SMS OTP authentication. Development responses include the OTP so local
# testing does not require an SMS account; production requires a provider adapter.
AGENT_AUTH_OTP_TTL_SECONDS=300
AGENT_AUTH_OTP_MAX_ATTEMPTS=5
AGENT_AUTH_REGISTRATION_TTL_SECONDS=900
AGENT_AUTH_SESSION_TTL_SECONDS=2592000

# WebAuthn relying-party settings. Origin is the administration web app origin.
INTERNAL_AUTH_RP_NAME=Dashchecker Administration
INTERNAL_AUTH_RP_ID=localhost
INTERNAL_AUTH_ORIGIN=http://localhost:3001
INTERNAL_AUTH_CHALLENGE_TTL_SECONDS=300
INTERNAL_AUTH_SESSION_TTL_SECONDS=28800
INTERNAL_ENROLLMENT_TTL_SECONDS=900
