NODE_ENV=development
PORT=3000

# Runtime connection. In Cloud Run, use the Supabase transaction pooler URL.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Migration connection. Use the Supabase direct connection URL.
DIRECT_URL=postgresql://postgres:password@direct-host:5432/postgres

# Inject these from Google Secret Manager/KMS when enabling inventory imports.
VOUCHER_KMS_KEY_NAME=projects/project-id/locations/global/keyRings/doraf/cryptoKeys/vouchers
VOUCHER_FINGERPRINT_KEY_BASE64=replace-with-at-least-32-random-bytes-in-base64
SESSION_FINGERPRINT_KEY_BASE64=replace-with-another-32-random-bytes-in-base64
