  providerStatus           String?                      @map("provider_status") @db.VarChar(80)
  authorizationDisplayText String?                      @map("authorization_display_text") @db.VarChar(500)
  initializedAt            DateTime?                    @map("initialized_at") @db.Timestamptz(6)
  lastVerifiedAt           DateTime?                    @map("last_verified_at") @db.Timestamptz(6)
  authorizationExpiresAt   DateTime                     @map("authorization_expires_at") @db.Timestamptz(6)
  nextReconciliationAt     DateTime?                    @map("next_reconciliation_at") @db.Timestamptz(6)
  version                  Int                          @default(1)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                    Order                        @relation("OrderPaymentAttempts", fields: [orderId], references: [id], onDelete: Restrict)
  acceptedByOrder          Order?                       @relation("AcceptedPaymentAttempt")
  reservation              InventoryReservation?
  providerEvents           PaymentEvent[]
  ledgerEntries            LedgerEntry[]
  refunds                  Refund[]

  @@unique([orderId, attemptNumber])
  @@index([state, nextReconciliationAt])
  @@map("payment_attempt")
}

