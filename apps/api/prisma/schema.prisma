model PaymentAttempt {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                  String                       @map("order_id") @db.Uuid
  attemptNumber            Int                          @map("attempt_number")
  provider                 String                       @default("PAYSTACK") @db.VarChar(40)
  providerReference        String                       @unique @map("provider_reference") @db.VarChar(80)
  syntheticEmailCiphertext Bytes                        @map("synthetic_email_ciphertext")
  syntheticEmailMask       String                       @map("synthetic_email_mask") @db.VarChar(160)
  expectedAmountMinor      BigInt                       @map("expected_amount_minor")
  currency                 String                       @default("GHS") @db.Char(3)
  state                    PaymentAttemptState          @default(CREATED)
  classification           PaymentAttemptClassification @default(PENDING)
  providerTransactionId    String?                      @map("provider_transaction_id") @db.VarChar(120)
