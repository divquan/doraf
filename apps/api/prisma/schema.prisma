generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  ACTIVE
  SUSPENDED

  @@map("agent_status")
}

enum OtpPurpose {
  AGENT_REGISTRATION
  AGENT_SIGN_IN
  AGENT_WITHDRAWAL

  @@map("otp_purpose")
}

enum ProductStatus {
  ACTIVE
  UNAVAILABLE

  @@map("product_status")
}

enum InternalUserStatus {
  ACTIVE
  SUSPENDED

  @@map("internal_user_status")
}

enum InternalRole {
  SUPPORT
  ADMINISTRATOR

  @@map("internal_role")
}

enum InternalCredentialType {
  PASSKEY

  @@map("internal_credential_type")
}

enum InternalAuthCeremonyType {
  PASSKEY_REGISTRATION
  PASSKEY_AUTHENTICATION

  @@map("internal_auth_ceremony_type")
}

enum VoucherAvailability {
  AVAILABLE
  RESERVED
  SOLD
  QUARANTINED
  VOID

  @@map("voucher_availability")
}

enum VoucherDisputeDisposition {
  NONE
  REPLACED
  REFUNDED

  @@map("voucher_dispute_disposition")
}

enum OrderChannelType {
  WEB

  @@map("order_channel_type")
}

enum OrderPaymentState {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  FULLY_REFUNDED

  @@map("order_payment_state")
}

enum OrderFulfillmentState {
  PENDING
  COMPLETE
  EXCEPTION
  REFUNDED
  PARTIALLY_REPLACED

  @@map("order_fulfillment_state")
}

enum OrderItemFulfillmentState {
  PENDING
  COMPLETE
  EXCEPTION
  REFUNDED

  @@map("order_item_fulfillment_state")
}

enum InventoryReservationState {
  ACTIVE
  CONSUMED
  RELEASED

  @@map("inventory_reservation_state")
}

enum PaymentAttemptState {
  CREATED
  PENDING_AUTHORIZATION
  VERIFYING
  RECONCILING
  SUCCESS
  FAILED
  ABANDONED

  @@map("payment_attempt_state")
}

enum PaymentAttemptClassification {
  PENDING
  ACCEPTED
  EXCESS

  @@map("payment_attempt_classification")
}

enum RefundState {
  REQUESTED
  APPROVED
  SUBMITTED
  PENDING
  SUCCESS
  FAILED
  CANCELLED

  @@map("refund_state")
}

enum PaymentEventProcessingState {
  RECEIVED
  PROCESSED
  IGNORED
  INVESTIGATION

  @@map("payment_event_processing_state")
}

enum VoucherAllocationType {
  ORIGINAL
  REPLACEMENT

  @@map("voucher_allocation_type")
}

enum LedgerEntryType {
  SALE_CREDIT
  SALE_REVERSAL_DEBIT
  PAYOUT_DEBIT
  PAYOUT_FEE_DEBIT
  PAYOUT_COMPENSATION_CREDIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT

  @@map("ledger_entry_type")
}

enum WalletHoldState {
  ACTIVE
  CONSUMED
  RELEASED

  @@map("wallet_hold_state")
}

enum WithdrawalState {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  AWAITING_MERCHANT_OTP
  SUBMITTED
  PENDING
  SUCCESS
  FAILED
  REVERSED

  @@map("withdrawal_state")
}

enum DeliveryChannel {
  SMS
  EMAIL

  @@map("delivery_channel")
}

enum DeliveryMessageState {
  PENDING
  SUBMITTED
  DELIVERED
  FAILED
  UNKNOWN

  @@map("delivery_message_state")
}

enum DeliveryAttemptState {
  PENDING
  SUBMITTED
  FAILED
  UNKNOWN

  @@map("delivery_attempt_state")
}

enum OutboxState {
  PENDING
  CLAIMED
  DISPATCHED
  FAILED

  @@map("outbox_state")
}

model AgentTenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  agent     Agent?
  orders    Order[]

  @@map("agent_tenant")
}

model Agent {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @unique @map("tenant_id") @db.Uuid
  name               String                 @db.VarChar(120)
  phoneCiphertext    Bytes                  @map("phone_ciphertext")
  phoneFingerprint   Bytes                  @unique @map("phone_fingerprint")
  phoneMask          String                 @map("phone_mask") @db.VarChar(32)
  webSalesId         String                 @unique @default(dbgenerated("lower(encode(gen_random_bytes(12), 'hex'::text))")) @map("web_sales_id") @db.VarChar(24)
  slug               String?                @unique @map("slug") @db.VarChar(30)
  storeName          String?                @map("store_name") @db.VarChar(60)
  tagline            String?                @map("tagline") @db.VarChar(120)
  logoUrl            String?                @map("logo_url") @db.VarChar(255)
  bannerUrl          String?                @map("banner_url") @db.VarChar(255)
  whatsappNumber     String?                @map("whatsapp_number") @db.VarChar(20)
  themePreset        String?                @default("default") @map("theme_preset") @db.VarChar(30)
  announcement       String?                @map("announcement") @db.VarChar(200)
  encryptionKeyId    String                 @map("encryption_key_id") @db.VarChar(100)
  formatVersion      Int                    @default(1) @map("format_version")
  status             AgentStatus            @default(ACTIVE)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             AgentTenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pricingOverrides   AgentPricingOverride[]
  productPrices      AgentProductPrice[]
  sessions           Session[]
  otpChallenges      OtpChallenge[]
  orders             Order[]
  wallet             WalletAccount?
  withdrawals        Withdrawal[]
  transferRecipients TransferRecipient[]

  @@index([status])
  @@map("agent")
}

model OtpChallenge {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose                    OtpPurpose
  agentId                    String?    @map("agent_id") @db.Uuid
  phoneCiphertext            Bytes      @map("phone_ciphertext")
  phoneFingerprint           Bytes      @map("phone_fingerprint")
  phoneMask                  String     @map("phone_mask") @db.VarChar(32)
  encryptionKeyId            String     @map("encryption_key_id") @db.VarChar(100)
  formatVersion              Int        @default(1) @map("format_version")
  verifierFingerprint        Bytes      @map("verifier_fingerprint")
  attemptCount               Int        @default(0) @map("attempt_count")
  maxAttempts                Int        @map("max_attempts")
  expiresAt                  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt                 DateTime?  @map("consumed_at") @db.Timestamptz(6)
  completionTokenFingerprint Bytes?     @unique @map("completion_token_fingerprint")
  completionExpiresAt        DateTime?  @map("completion_expires_at") @db.Timestamptz(6)
  completedAt                DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  agent                      Agent?     @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([phoneFingerprint, purpose, expiresAt])
  @@index([agentId, purpose, expiresAt])
  @@map("otp_challenge")
}

model InternalUser {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName             String                    @map("display_name") @db.VarChar(120)
  role                    InternalRole
  status                  InternalUserStatus        @default(ACTIVE)
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions                Session[]
  auditEvents             AuditEvent[]
  credentials             InternalCredential[]
  enrollmentTokens        InternalEnrollmentToken[] @relation("EnrollmentTokenTarget")
  createdEnrollmentTokens InternalEnrollmentToken[] @relation("EnrollmentTokenCreator")
  authCeremonies          InternalAuthCeremony[]
  refunds                 Refund[]
  approvedWithdrawals     Withdrawal[]              @relation("WithdrawalApprover")

  @@index([status, role])
  @@map("internal_user")
}

model InternalCredential {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalUserId String                 @map("internal_user_id") @db.Uuid
  type           InternalCredentialType @default(PASSKEY)
  name           String                 @db.VarChar(80)
  credentialId   String                 @unique @map("credential_id") @db.VarChar(1024)
  publicKey      Bytes                  @map("public_key")
  counter        BigInt                 @default(0)
  transports     String[]
  deviceType     String                 @map("device_type") @db.VarChar(20)
  backedUp       Boolean                @map("backed_up")
  aaguid         String                 @db.VarChar(36)
  lastUsedAt     DateTime?              @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  internalUser   InternalUser           @relation(fields: [internalUserId], references: [id], onDelete: Restrict)

  @@index([internalUserId, revokedAt])
  @@map("internal_credential")
}

model InternalEnrollmentToken {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalUserId          String                 @map("internal_user_id") @db.Uuid
  createdByInternalUserId String?                @map("created_by_internal_user_id") @db.Uuid
  tokenFingerprint        Bytes                  @unique @map("token_fingerprint")
  expiresAt               DateTime               @map("expires_at") @db.Timestamptz(6)
  consumedAt              DateTime?              @map("consumed_at") @db.Timestamptz(6)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  internalUser            InternalUser           @relation("EnrollmentTokenTarget", fields: [internalUserId], references: [id], onDelete: Restrict)
  createdBy               InternalUser?          @relation("EnrollmentTokenCreator", fields: [createdByInternalUserId], references: [id], onDelete: Restrict)
  ceremonies              InternalAuthCeremony[]

  @@index([internalUserId, expiresAt])
  @@map("internal_enrollment_token")
}

model InternalAuthCeremony {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              InternalAuthCeremonyType
  internalUserId    String?                  @map("internal_user_id") @db.Uuid
  enrollmentTokenId String?                  @map("enrollment_token_id") @db.Uuid
  challenge         String                   @unique @db.VarChar(160)
  credentialName    String?                  @map("credential_name") @db.VarChar(80)
  attemptCount      Int                      @default(0) @map("attempt_count")
  expiresAt         DateTime                 @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?                @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  internalUser      InternalUser?            @relation(fields: [internalUserId], references: [id], onDelete: Restrict)
  enrollmentToken   InternalEnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id], onDelete: Restrict)

  @@index([type, expiresAt])
  @@index([internalUserId, expiresAt])
  @@map("internal_auth_ceremony")
}

model Session {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId                String?       @map("agent_id") @db.Uuid
  internalUserId         String?       @map("internal_user_id") @db.Uuid
  tokenFingerprint       Bytes         @unique @map("token_fingerprint")
  authenticationStrength String        @map("authentication_strength") @db.VarChar(40)
  authenticatedAt        DateTime      @map("authenticated_at") @db.Timestamptz(6)
  stepUpAt               DateTime?     @map("step_up_at") @db.Timestamptz(6)
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz(6)
  lastSeenAt             DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  revokedAt              DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  agent                  Agent?        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  internalUser           InternalUser? @relation(fields: [internalUserId], references: [id], onDelete: Restrict)

  @@index([internalUserId, expiresAt])
  @@index([agentId, expiresAt])
  @@map("session")
}

model AuditEvent {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorInternalUserId    String       @map("actor_internal_user_id") @db.Uuid
  actorRole              InternalRole @map("actor_role")
  action                 String       @db.VarChar(100)
  entityType             String       @map("entity_type") @db.VarChar(80)
  entityId               String       @map("entity_id") @db.VarChar(160)
  reason                 String       @db.VarChar(500)
  authenticationStrength String       @map("authentication_strength") @db.VarChar(40)
  requestId              String       @map("request_id") @db.VarChar(100)
  safeMetadata           Json         @default("{}") @map("safe_metadata")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  actor                  InternalUser @relation(fields: [actorInternalUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorInternalUserId, createdAt])
  @@map("audit_event")
}

model OutboxEvent {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType        String      @map("event_type") @db.VarChar(100)
  aggregateType    String      @map("aggregate_type") @db.VarChar(80)
  aggregateId      String      @map("aggregate_id") @db.VarChar(160)
  aggregateVersion Int         @map("aggregate_version")
  payload          Json        @default("{}")
  state            OutboxState @default(PENDING)
  attemptCount     Int         @default(0) @map("attempt_count")
  availableAt      DateTime    @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt        DateTime?   @map("claimed_at") @db.Timestamptz(6)
  claimToken       String?     @map("claim_token") @db.Uuid
  dispatchedAt     DateTime?   @map("dispatched_at") @db.Timestamptz(6)
  lastError        String?     @map("last_error") @db.VarChar(1000)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([aggregateType, aggregateId, aggregateVersion, eventType])
  @@index([state, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope              String   @db.VarChar(200)
  key                String   @db.VarChar(200)
  operation          String   @db.VarChar(100)
  requestFingerprint Bytes    @map("request_fingerprint")
  outcomeReference   String?  @map("outcome_reference") @db.VarChar(160)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model Product {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String                 @unique @db.VarChar(40)
  name               String                 @db.VarChar(120)
  scopeDisclosure    String                 @map("scope_disclosure")
  disclosureVersion  Int                    @default(1) @map("disclosure_version")
  status             ProductStatus          @default(UNAVAILABLE)
  displayOrder       Int                    @map("display_order")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  pricingPolicies    ProductPricingPolicy[]
  agentOverrides     AgentPricingOverride[]
  agentProductPrices AgentProductPrice[]
  inventoryBatches   InventoryBatch[]
  vouchers           Voucher[]
  orders             Order[]
  orderItems         OrderItem[]
  reservations       InventoryReservation[]

  @@index([status, displayOrder])
  @@map("product")
}

model ProductPricingPolicy {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId               String    @map("product_id") @db.Uuid
  basePriceMinor          BigInt    @map("base_price_minor")
  maximumRetailPriceMinor BigInt    @map("maximum_retail_price_minor")
  currency                String    @default("GHS") @db.Char(3)
  effectiveFrom           DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo             DateTime? @map("effective_to") @db.Timestamptz(6)
  reason                  String    @db.VarChar(500)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product                 Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, effectiveFrom])
  @@map("product_pricing_policy")
}

model AgentPricingOverride {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId                 String    @map("agent_id") @db.Uuid
  productId               String    @map("product_id") @db.Uuid
  basePriceMinor          BigInt?   @map("base_price_minor")
  maximumRetailPriceMinor BigInt?   @map("maximum_retail_price_minor")
  currency                String    @default("GHS") @db.Char(3)
  effectiveFrom           DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo             DateTime? @map("effective_to") @db.Timestamptz(6)
  reason                  String    @db.VarChar(500)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent                   Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  product                 Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([agentId, productId, effectiveFrom])
  @@map("agent_pricing_override")
}

model AgentProductPrice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String   @map("agent_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  retailPriceMinor BigInt   @map("retail_price_minor")
  currency         String   @default("GHS") @db.Char(3)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([agentId, productId])
  @@index([productId])
  @@map("agent_product_price")
}

model InventoryBatch {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId                String    @map("product_id") @db.Uuid
  vendorName               String    @map("vendor_name") @db.VarChar(160)
  vendorReference          String    @map("vendor_reference") @db.VarChar(160)
  acquisitionDate          DateTime  @map("acquisition_date") @db.Date
  unitAcquisitionCostMinor BigInt    @map("unit_acquisition_cost_minor")
  currency                 String    @default("GHS") @db.Char(3)
  sourceRowCount           Int       @map("source_row_count")
  acceptedRowCount         Int       @map("accepted_row_count")
  encryptedDataKey         Bytes     @map("encrypted_data_key")
  kmsKeyVersion            String    @map("kms_key_version") @db.VarChar(300)
  cryptoVersion            Int       @default(1) @map("crypto_version")
  uploadedByActorId        String    @map("uploaded_by_actor_id") @db.Uuid
  importedAt               DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  product                  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  vouchers                 Voucher[]

  @@unique([id, productId])
  @@index([productId, acquisitionDate, importedAt])
  @@map("inventory_batch")
}

model Voucher {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId            String                     @map("batch_id") @db.Uuid
  productId          String                     @map("product_id") @db.Uuid
  serialCiphertext   Bytes                      @map("serial_ciphertext")
  serialNonce        Bytes                      @map("serial_nonce")
  serialAuthTag      Bytes                      @map("serial_auth_tag")
  serialFingerprint  Bytes                      @unique @map("serial_fingerprint")
  serialMask         String                     @map("serial_mask") @db.VarChar(64)
  serialKeyVersion   String                     @map("serial_key_version") @db.VarChar(300)
  pinCiphertext      Bytes                      @map("pin_ciphertext")
  pinNonce           Bytes                      @map("pin_nonce")
  pinAuthTag         Bytes                      @map("pin_auth_tag")
  pinFingerprint     Bytes                      @unique @map("pin_fingerprint")
  pinMask            String                     @map("pin_mask") @db.VarChar(32)
  pinKeyVersion      String                     @map("pin_key_version") @db.VarChar(300)
  cryptoVersion      Int                        @default(1) @map("crypto_version")
  availability       VoucherAvailability        @default(AVAILABLE)
  disputeDisposition VoucherDisputeDisposition  @default(NONE) @map("dispute_disposition")
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  batch              InventoryBatch             @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict)
  product            Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  events             InventoryEvent[]
  reservationItems   InventoryReservationItem[]
  allocations        VoucherAllocation[]

  @@index([productId, availability, batchId, createdAt])
  @@index([batchId])
  @@map("voucher")
}

model Order {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicReference          String                   @unique @map("public_reference") @db.VarChar(32)
  tenantId                 String                   @map("tenant_id") @db.Uuid
  agentId                  String                   @map("agent_id") @db.Uuid
  channelType              OrderChannelType         @map("channel_type")
  channelIdSnapshot        String                   @map("channel_id_snapshot") @db.VarChar(80)
  productId                String                   @map("product_id") @db.Uuid
  quantity                 Int
  currency                 String                   @default("GHS") @db.Char(3)
  baseTotalMinor           BigInt                   @map("base_total_minor")
  retailTotalMinor         BigInt                   @map("retail_total_minor")
  agentProfitTotalMinor    BigInt                   @map("agent_profit_total_minor")
  deliveryPhoneCiphertext  Bytes                    @map("delivery_phone_ciphertext")
  deliveryPhoneFingerprint Bytes                    @map("delivery_phone_fingerprint")
  deliveryPhoneMask        String                   @map("delivery_phone_mask") @db.VarChar(32)
  deliveryEmailCiphertext  Bytes?                   @map("delivery_email_ciphertext")
  deliveryEmailFingerprint Bytes?                   @map("delivery_email_fingerprint")
  deliveryEmailMask        String?                  @map("delivery_email_mask") @db.VarChar(160)
  payerPhoneCiphertext     Bytes?                   @map("payer_phone_ciphertext")
  payerPhoneFingerprint    Bytes?                   @map("payer_phone_fingerprint")
  payerPhoneMask           String?                  @map("payer_phone_mask") @db.VarChar(32)
  payerNetwork             String?                  @map("payer_network") @db.VarChar(40)
  contactEncryptionKeyId   String                   @map("contact_encryption_key_id") @db.VarChar(100)
  contactFormatVersion     Int                      @default(1) @map("contact_format_version")
  priceExpiresAt           DateTime                 @map("price_expires_at") @db.Timestamptz(6)
  acceptedPaymentAttemptId String?                  @unique @map("accepted_payment_attempt_id") @db.Uuid
  paymentState             OrderPaymentState        @default(UNPAID) @map("payment_state")
  fulfillmentState         OrderFulfillmentState    @default(PENDING) @map("fulfillment_state")
  version                  Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                   AgentTenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent                    Agent                    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  product                  Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  items                    OrderItem[]
  paymentAttempts          PaymentAttempt[]         @relation("OrderPaymentAttempts")
  acceptedPaymentAttempt   PaymentAttempt?          @relation("AcceptedPaymentAttempt", fields: [acceptedPaymentAttemptId], references: [id], onDelete: Restrict)
  reservations             InventoryReservation[]
  ledgerEntries            LedgerEntry[]
  deliveryMessages         DeliveryMessage[]
  refunds                  Refund[]
  recoveryChallenges       BuyerRecoveryChallenge[]

  @@index([agentId, createdAt])
  @@index([tenantId, createdAt])
  @@index([productId, createdAt])
  @@map("order")
}

model BuyerRecoveryChallenge {
