# Base URL of the Dashchecker NestJS API service
DASHCHECKER_API_URL=http://localhost:3000/v1

# Public base URL of this buyer storefront app (subdomain routing is derived from this)
DASHCHECKER_STOREFRONT_URL=http://localhost:3003

# Public base URL of the agent portal (used to link to registration page)
NEXT_PUBLIC_DASHCHECKER_AGENT_WEB_URL=http://localhost:3002
