DASHCHECKER_API_URL=http://localhost:3000/v1
# Public base URL of the buyer storefront (apps/storefront). The agent portal
# builds buyer-facing sales links against this. Defaults to the storefront dev
# port (3003) when unset; DASHCHECKER_AGENT_WEB_URL is accepted as a legacy fallback.
# Set BOTH forms in production (e.g. Vercel): the bare name is server-only,
# while NEXT_PUBLIC_ is the only form inlined into client bundles at build
# time — store links render in client components, so without it they fall back
# to localhost. Redeploy after changing NEXT_PUBLIC_ values (frozen at build).
DASHCHECKER_STOREFRONT_URL=http://localhost:3003
NEXT_PUBLIC_DASHCHECKER_STOREFRONT_URL=http://localhost:3003
# Legacy fallback for the storefront URL. Prefer DASHCHECKER_STOREFRONT_URL.
DASHCHECKER_AGENT_WEB_URL=http://localhost:3002
