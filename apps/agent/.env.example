DORAF_API_URL=http://localhost:3000/v1
# Public base URL of the buyer storefront (apps/storefront). The agent portal
# builds buyer-facing sales links against this. Defaults to the storefront dev
# port (3003) when unset; DORAF_AGENT_WEB_URL is accepted as a legacy fallback.
DORAF_STOREFRONT_URL=http://localhost:3003
# Legacy fallback for the storefront URL. Prefer DORAF_STOREFRONT_URL.
DORAF_AGENT_WEB_URL=http://localhost:3002
